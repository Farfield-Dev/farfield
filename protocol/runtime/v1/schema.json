{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farfield.dev/protocol/runtime/v1/schema.json",
  "title": "Farfield Runtime event v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "run_id",
    "operation_id",
    "sequence",
    "attempt",
    "kind",
    "from",
    "to",
    "occurred_at",
    "recorded_at",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "farfield.runtime.event.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 255},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "sequence": {"type": "integer", "minimum": 0},
    "attempt": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["run.created", "run.transition", "run.checkpoint"]},
    "from": {
      "type": ["string", "null"],
      "enum": ["queued", "running", "waiting", "sleeping", "completed", "failed", "cancelled", "ambiguous", null]
    },
    "to": {
      "enum": ["queued", "running", "waiting", "sleeping", "completed", "failed", "cancelled", "ambiguous"]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "checkpoint": {},
    "previous_event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "run.created"}}},
      "then": {
        "properties": {
          "sequence": {"const": 0},
          "attempt": {"const": 0},
          "from": {"type": "null"},
          "to": {"const": "queued"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "run.transition"}}},
      "then": {
        "required": ["previous_event_sha256"],
        "properties": {"from": {"type": "string"}, "sequence": {"minimum": 1}}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "run.checkpoint"}}},
      "then": {
        "required": ["checkpoint", "previous_event_sha256"],
        "properties": {"from": {"type": "string"}, "sequence": {"minimum": 1}}
      }
    }
  ]
}
