{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farfield.dev/protocol/history/v2/segment.schema.json",
  "title": "Farfield History Segment v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "conversation_id",
    "conversation_hash",
    "created_at",
    "entries",
    "segment_sha256"
  ],
  "properties": {
    "schema_version": {"const": "farfield.history.segment.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 255},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "conversation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/entry"}
    },
    "segment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["record"],
      "properties": {
        "record": {"$ref": "#/$defs/record"},
        "content": {}
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "conversation_id",
        "kind",
        "occurred_at",
        "recorded_at",
        "tags",
        "content",
        "record_sha256"
      ],
      "properties": {
        "schema_version": {"const": "farfield.history.record.v2"},
        "id": {"type": "string", "minLength": 1, "maxLength": 255},
        "conversation_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "occurred_at": {"type": "string", "format": "date-time"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "sequence": {"type": ["integer", "null"], "minimum": 0},
        "trace_id": {"type": ["string", "null"]},
        "span_id": {"type": ["string", "null"]},
        "parent_id": {"type": ["string", "null"]},
        "agent": {"type": ["string", "null"]},
        "tool": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "tags": {"type": "object", "additionalProperties": {"type": "string"}},
        "content": {"$ref": "#/$defs/content_ref"},
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "content_ref": {
      "oneOf": [
        {
          "type": "object",
          "required": ["sha256", "size", "media_type", "key", "storage", "entry_index"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "size": {"type": "integer", "minimum": 0},
            "media_type": {"const": "application/json"},
            "key": {"type": "string", "pattern": "^history/v2/conversations/[0-9a-f]{64}/segments/[0-9a-f]{64}\\.json$"},
            "storage": {"const": "segment"},
            "entry_index": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["sha256", "size", "media_type", "key", "storage"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "size": {"type": "integer", "minimum": 0},
            "media_type": {"const": "application/json"},
            "key": {"type": "string", "pattern": "^history/v2/blobs/sha256/[0-9a-f]{2}/[0-9a-f]{62}$"},
            "storage": {"const": "blob"}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
